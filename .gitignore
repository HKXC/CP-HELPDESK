# Root gitignore — repo covers whole E:\HELPDESK 004 (app lives in helpdesk/)
# (helpdesk/.gitignore still applies inside helpdesk/; this is belt & suspenders)

# secrets — NEVER commit
helpdesk/.env*

# attachment binaries + local runtime logs (metadata in DB only)
helpdesk/uploads/
helpdesk/logs/
helpdesk/dev.log

# dependencies + build output
helpdesk/node_modules/
helpdesk/.next/
helpdesk/out/
helpdesk/build/

# vercel + typescript caches
helpdesk/.vercel
helpdesk/*.tsbuildinfo
helpdesk/next-env.d.ts

# OS / debug
.DS_Store
*.pem
npm-debug.log*
