# Copy to .env and fill in — never commit .env itself.
# Local dev defaults work out of the box with setup.ps1 (change passwords on shared machines).
# Example for reference:
#   DATABASE_URL="postgresql://helpdesk:helpdesk123@localhost:5432/helpdesk?schema=public"

# Local docker-compose / native Postgres password (never commit the real value — local .env only)
POSTGRES_PASSWORD="change-me-local-only"

# Pooled connection (Neon pooled :6543 URL on Vercel, local URL in dev)
# NOTE: password here must match POSTGRES_PASSWORD above on a local machine.
DATABASE_URL="postgresql://helpdesk:change-me-local-only@localhost:5432/helpdesk?schema=public"
# Direct connection for migrations (Neon direct :5432 URL on Vercel, same as DATABASE_URL locally)
DIRECT_URL="postgresql://helpdesk:change-me-local-only@localhost:5432/helpdesk?schema=public"

# Vercel Blob (prod file storage). Local dev falls back to helpdesk/uploads/ disk.
BLOB_READ_WRITE_TOKEN=""

# Seed passwords — required only when running `prisma db seed`, never on Vercel build
# (setup.ps1 seeds with these; login uses the same values)
SEED_ADMIN_PASSWORD="change-me-admin-1"
SEED_TECH_PASSWORD="change-me-tech-1"
SEED_USER_PASSWORD="change-me-user-1"

# Local web port — used by setup.ps1 -Start (npm run dev:4502 always uses 4502)
PORT="4502"
